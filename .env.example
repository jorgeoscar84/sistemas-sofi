# Ejemplo de variables de entorno de producción.
# Copie este archivo como .env solo para desarrollo local; en Dokploy se configuran
# en la pestaña Environment de la aplicación.

NODE_ENV=production
HOST=0.0.0.0
PORT=4000
TZ=America/Guayaquil
APP_NAME=Sistemas Sofi

# Cambiar por un secreto largo y aleatorio (por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# Cuenta inicial de la plataforma (solo se usa al crear la base por primera vez)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=cambiar_por_una_contrasena_larga
SUPERADMIN_EMAIL=admin@su-dominio.com

# En producción: no crear empresas ni usuarios demo.
SEED_DEMO=false

# Persistencia (montar /app/data y /app/storage como volúmenes en Dokploy)
PLATFORM_DB_PATH=/app/data/platform.db
TENANTS_DIR=/app/data/tenants
STORAGE_DIR=/app/storage
CERT_DIR=/app/storage/certs
